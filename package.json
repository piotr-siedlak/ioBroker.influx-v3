{
    "name": "iobroker.influx-v3",
    "version": "0.1.0",
    "description": "Log ioBroker states into InfluxDB 3 (Core / Enterprise) with per-state tags and SQL history",
    "author": {
        "name": "Piotr Siedlak",
        "email": "siedlak.piotr@gmail.com"
    },
    "homepage": "https://github.com/piotr-siedlak/ioBroker.influx-v3",
    "license": "MIT",
    "keywords": [
        "ioBroker",
        "influxdb",
        "influxdb3",
        "history",
        "logging",
        "time series",
        "sql",
        "grafana"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/piotr-siedlak/ioBroker.influx-v3.git"
    },
    "bugs": {
        "url": "https://github.com/piotr-siedlak/ioBroker.influx-v3/issues"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@iobroker/adapter-core": "^3.4.3"
    },
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.2",
        "@iobroker/adapter-dev": "^1.5.0",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/testing": "^6.3.1",
        "@iobroker/types": "^7.2.5",
        "@tsconfig/node22": "^22.0.6",
        "@types/node": "^22.20.5",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3"
    },
    "main": "build/main.js",
    "files": [
        "admin/",
        "build/",
        "docs/",
        "io-package.json",
        "LICENSE"
    ],
    "scripts": {
        "prebuild": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
        "build": "tsc -p tsconfig.build.json",
        "check": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint -c eslint.config.mjs .",
        "test:unit": "mocha --config .mocharc.json \"test/unit/**/*.test.ts\"",
        "test:influx": "mocha --config .mocharc.json --timeout 60000 \"test/influx/**/*.test.ts\"",
        "test:package": "mocha --config .mocharc.json test/package.js",
        "test:integration": "mocha --config .mocharc.json test/integration.js --exit",
        "test": "npm run test:unit && npm run test:package",
        "load-test": "tsx scripts/loadtest.ts",
        "translate": "translate-adapter",
        "release": "release-script"
    }
}
